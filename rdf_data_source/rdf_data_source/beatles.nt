<http://dbpedia.org/resource/George_Harrison>	<http://www.w3.org/2000/01/rdf-schema#comment>	"\u0414\u0436\u043E\u0440\u0434\u0436 \u0425\u0430\u0301\u0440\u0440\u0438\u0441\u043E\u043D (\u0430\u043D\u0433\u043B. George Harrison; 25 \u0444\u0435\u0432\u0440\u0430\u043B\u044F 1943[\u2026], \u041B\u0438\u0432\u0435\u0440\u043F\u0443\u043B\u044C, \u041B\u0430\u043D\u043A\u0430\u0448\u0438\u0440 \u2014 29 \u043D\u043E\u044F\u0431\u0440\u044F 2001[\u2026], \u041B\u043E\u0441-\u0410\u043D\u0434\u0436\u0435\u043B\u0435\u0441, \u041A\u0430\u043B\u0438\u0444\u043E\u0440\u043D\u0438\u044F) \u2014 \u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u0440\u043E\u043A-\u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442, \u043F\u0435\u0432\u0435\u0446, \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0442\u043E\u0440, \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C, \u043F\u0440\u043E\u0434\u044E\u0441\u0435\u0440, \u0441\u0438\u0442\u0430\u0440\u0438\u0441\u0442 \u0438 \u0433\u0438\u0442\u0430\u0440\u0438\u0441\u0442, \u043F\u043E\u043B\u0443\u0447\u0438\u0432\u0448\u0438\u0439 \u043D\u0430\u0438\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u043A\u0430\u043A \u0441\u043E\u043B\u043E-\u0433\u0438\u0442\u0430\u0440\u0438\u0441\u0442 The Beatles. \u0425\u0430\u0440\u0440\u0438\u0441\u043E\u043D \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 21-\u0435 \u043C\u0435\u0441\u0442\u043E \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 100 \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0445 \u0433\u0438\u0442\u0430\u0440\u0438\u0441\u0442\u043E\u0432 \u0432\u0441\u0435\u0445 \u0432\u0440\u0435\u043C\u0451\u043D \u043F\u043E \u0432\u0435\u0440\u0441\u0438\u0438 \u0436\u0443\u0440\u043D\u0430\u043B\u0430 Rolling Stone (\u0432 \u0432\u0435\u0440\u0441\u0438\u0438 2003 \u0433\u043E\u0434\u0430) \u0438 11-\u0435 \u043C\u0435\u0441\u0442\u043E \u0432 \u0432\u0435\u0440\u0441\u0438\u0438 \u0441\u043F\u0438\u0441\u043A\u0430 2011 \u0433\u043E\u0434\u0430."@ru .
