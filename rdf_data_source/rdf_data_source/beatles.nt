<http://dbpedia.org/resource/Paul_McCartney>	<http://www.w3.org/2000/01/rdf-schema#comment>	"\u0421\u044D\u0440 \u0414\u0436\u0435\u0439\u043C\u0441 \u041F\u043E\u043B \u041C\u0430\u043A\u043A\u0430\u0301\u0440\u0442\u043D\u0438 (\u0430\u043D\u0433\u043B. James Paul McCartney; \u0440\u043E\u0434. 18 \u0438\u044E\u043D\u044F 1942, \u041B\u0438\u0432\u0435\u0440\u043F\u0443\u043B\u044C, \u0410\u043D\u0433\u043B\u0438\u044F, \u0412\u0435\u043B\u0438\u043A\u043E\u0431\u0440\u0438\u0442\u0430\u043D\u0438\u044F) \u2014 \u0431\u0440\u0438\u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442, \u043C\u0443\u043B\u044C\u0442\u0438\u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043B\u0438\u0441\u0442, \u043F\u0438\u0441\u0430\u0442\u0435\u043B\u044C \u0438 \u043F\u0440\u043E\u0434\u044E\u0441\u0435\u0440. \u041E\u0434\u0438\u043D \u0438\u0437 \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u0435\u0439 \u0433\u0440\u0443\u043F\u043F\u044B The Beatles. 16-\u043A\u0440\u0430\u0442\u043D\u044B\u0439 \u043E\u0431\u043B\u0430\u0434\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0435\u043C\u0438\u0438 \u00AB\u0413\u0440\u044D\u043C\u043C\u0438\u00BB. \u0412 2011 \u0433\u043E\u0434\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u043D \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043B\u0443\u0447\u0448\u0438\u0445 \u0431\u0430\u0441-\u0433\u0438\u0442\u0430\u0440\u0438\u0441\u0442\u043E\u0432 \u0432\u0441\u0435\u0445 \u0432\u0440\u0435\u043C\u0451\u043D \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043E\u043F\u0440\u043E\u0441\u0443, \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u043D\u043D\u043E\u043C\u0443 \u0436\u0443\u0440\u043D\u0430\u043B\u043E\u043C Rolling Stone \u0441\u0440\u0435\u0434\u0438 \u0447\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u0439, \u0437\u0430\u043D\u044F\u0432 3-\u0435 \u043C\u0435\u0441\u0442\u043E. \u0412 \u0441\u043F\u0438\u0441\u043A\u0435 \u0440\u0435\u0434\u0430\u043A\u0446\u0438\u0438 \u044D\u0442\u043E\u0433\u043E \u0436\u0443\u0440\u043D\u0430\u043B\u0430 2020 \u0433\u043E\u0434\u0430 \u0437\u0430\u043D\u044F\u043B 9-\u0435 \u043C\u0435\u0441\u0442\u043E. \u0415\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u043E\u0439 \u0434\u0438\u0430\u043F\u0430\u0437\u043E\u043D \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u043E\u043A\u0442\u0430\u0432. \u042F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043B\u0435\u0432\u0448\u043E\u0439, \u0430 \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0438\u0433\u0440\u0430\u0435\u0442 \u043D\u0430 \u043B\u0435\u0432\u043E\u0440\u0443\u043A\u0438\u0445 \u0433\u0438\u0442\u0430\u0440\u0430\u0445."@ru .
